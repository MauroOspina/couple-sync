# Configuración de Supabase para sincronización en tiempo real
# Obtén estas claves en tu panel de Supabase: Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Solo para `npm run sugerencias`, en .env.local (NO aquí, NO con prefijo EXPO_PUBLIC_):
# SUPABASE_SECRET_KEY=sb_secret_...
